# --- Logging ---
# INFO shows agent turn timing + per-LLM/tool lines. DEBUG also dumps the full
# LLM payload (system prompt + conversation history).
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated allowlist of origins, or "*" for any. The mobile app calls the
# API directly (not from a browser), so "*" is a safe default; restrict it if you
# add a web frontend, e.g. CORS_ALLOW_ORIGINS=https://app.example.com
CORS_ALLOW_ORIGINS=*

# --- Database ---
# For local docker-compose the default below points at the bundled postgres.
# For quick local runs without postgres you can use: sqlite:///./finance.db
DATABASE_URL=postgresql+psycopg2://finance:finance@db:5432/finance

# --- Auth ---
# "firebase" (default, production) verifies Firebase ID tokens.
# "dev" trusts X-Dev-Uid / X-Dev-Email headers — for local testing ONLY.
AUTH_MODE=firebase
# Firebase service-account credentials (needed when AUTH_MODE=firebase).
# Option A — a file path:
FIREBASE_CREDENTIALS_FILE=./serviceAccount.json
# Option B — the service-account JSON inline (raw or base64). Preferred in
# production so no secret file is shipped; takes precedence over the file path.
# Base64-encode with: base64 -w0 serviceAccount.json
FIREBASE_CREDENTIALS_JSON=
# Optional: normally inferred from the credential; set to override or for ADC.
FIREBASE_PROJECT_ID=
# If none of the above are set, Application Default Credentials are used.

# --- LLM agent ---
# LangChain provider:model string. Swap provider/model here only.
LLM_MODEL=google_genai:gemini-3.5-flash
# Shared server Gemini key (from ai.google.dev), used when a user hasn't set
# their own. Leave blank to require every user to bring their own key.
LLM_API_KEY=
# Optional agent tuning.
LLM_TIMEOUT_S=45
LLM_MAX_RETRIES=2
AGENT_RECURSION_LIMIT=12

# --- SMS auto-capture agent ---
# Optional separate, usually cheaper/faster, provider:model for turning bank/UPI
# SMS into structured expenses. Falls back to LLM_MODEL when blank. A user can
# also override this per-account (with their own key) in the app settings.
SMS_LLM_MODEL=

# Fernet key used to encrypt per-user bring-your-own LLM keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
