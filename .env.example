# --- Database ---
# For local docker-compose the default below points at the bundled postgres.
# For quick local runs without postgres you can use: sqlite:///./finance.db
DATABASE_URL=postgresql+psycopg2://finance:finance@db:5432/finance

# --- Auth ---
# "firebase" (default, production) verifies Firebase ID tokens.
# "dev" trusts X-Dev-Uid / X-Dev-Email headers — for local testing ONLY.
AUTH_MODE=firebase
# Path to a Firebase service-account JSON (needed when AUTH_MODE=firebase).
# If unset, Application Default Credentials are used.
FIREBASE_CREDENTIALS_FILE=./serviceAccount.json

# --- LLM (Phase 2; optional here) ---
# Hosted shared key used when a user has not supplied their own key.
ANTHROPIC_API_KEY=
# Fernet key used to encrypt per-user BYO LLM keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
